# Copy to .env and fill in. NEVER commit .env.

# Added automatically when Vercel Blob is connected.
BLOB_READ_WRITE_TOKEN=

# Added automatically by the Vercel Upstash integration. The code also accepts
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public site URL, used to build password-reset links.
FRONTEND_ORIGIN=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Seeds the first admin account. Password requires 10+ characters, a letter and a number.
ADMIN_EMAIL=support@iglooparking.com
ADMIN_PASSWORD=change-this-before-first-run
ADMIN_CREDENTIALS_VERSION=

# Optional SMTP configuration. Without it, reset links print to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Igloo Parking <support@iglooparking.com>"
