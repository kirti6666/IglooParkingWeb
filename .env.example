# Copy to .env and fill in. NEVER commit .env.

# Added automatically when Vercel Blob is connected.
BLOB_READ_WRITE_TOKEN=

# Public site URL, used to build password-reset links.
FRONTEND_ORIGIN=http://localhost:3000

# Used for sessions and Blob database encryption. Never change it after data is
# published unless the database is intentionally being reset.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Seeds the first admin account. Password requires 10+ characters, a letter and a number.
ADMIN_EMAIL=support@iglooparking.com
ADMIN_PASSWORD=change-this-before-first-run
ADMIN_CREDENTIALS_VERSION=

# Gmail SMTP. Turn on 2-Step Verification for this Google account, then create a
# 16-character App Password. Use a Gmail/Google Workspace mailbox as SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=replace-with-16-character-google-app-password
MAIL_FROM="Igloo Parking Website <your-gmail-address@gmail.com>"
# All contact, host-registration, and valet enquiries are delivered here.
WEBSITE_ENQUIRY_TO_EMAIL=support@iglooparking.com
