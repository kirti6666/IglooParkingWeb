# Copy to .env and fill in. NEVER commit .env.

# Added automatically when Vercel Blob is connected.
BLOB_READ_WRITE_TOKEN=

# Public site URL, used to build password-reset links.
FRONTEND_ORIGIN=http://localhost:3000

# Used for sessions and Blob database encryption. Never change it after data is
# published unless the database is intentionally being reset.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Seeds the first admin account. Password requires 10+ characters, a letter and a number.
ADMIN_EMAIL=support@iglooparking.com
ADMIN_PASSWORD=change-this-before-first-run
ADMIN_CREDENTIALS_VERSION=

# Titan SMTP. In Titan, enable third-party email access first. If mailbox 2FA is
# enabled, create and use a Titan application password instead of the login password.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@iglooparking.com
SMTP_PASS=replace-with-titan-mailbox-or-app-password
MAIL_FROM="Igloo Parking <support@iglooparking.com>"
# All contact, host-registration, and valet enquiries are delivered here.
WEBSITE_ENQUIRY_TO_EMAIL=support@iglooparking.com
