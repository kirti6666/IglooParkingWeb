# Copy to .env and fill in. NEVER commit .env.

# Optional persistent storage root. Local development uses ./data and ./uploads.
IGLOO_STORAGE_DIR=

# Public site URL, used to build password-reset links.
FRONTEND_ORIGIN=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Seeds the first admin account. Password requires 10+ characters, a letter and a number.
ADMIN_EMAIL=support@iglooparking.com
ADMIN_PASSWORD=change-this-before-first-run
ADMIN_CREDENTIALS_VERSION=

# Optional SMTP configuration. Without it, reset links print to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Igloo Parking <support@iglooparking.com>"
