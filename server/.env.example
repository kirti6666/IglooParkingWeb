# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------

PORT=4000

# Where the website runs. Used for CORS and for building reset links.
FRONTEND_ORIGIN=http://localhost:5173

# Sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# The first admin account, seeded on first boot only.
ADMIN_EMAIL=support@iglooparking.com
ADMIN_PASSWORD=change-this-before-first-run

# SMTP for password-reset emails. Any provider works
# (Gmail app password, Zoho, SendGrid, Mailgun, Amazon SES...).
# Leave SMTP_HOST empty in development and reset links print to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Igloo Parking <support@iglooparking.com>"
